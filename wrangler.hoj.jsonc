{
  // HOJ(문제 은행) 배포 설정 - Actions 의 deploy-hoj 잡이 `wrangler deploy --config wrangler.hoj.jsonc` 로 쓴다.
  //
  // 왜 이 파일이 있나:
  //   ① 대시보드 Git 연동(Workers Builds)은 org 에 GitHub App 설치가 필요하고 org owner 만 할 수 있다
  //   ② Pages 경로도 막혔다 - `wrangler pages project create` 가 먹지 않아 "project does not exist" 로 실패
  //   그래서 API 토큰으로 Worker 를 직접 올린다. 토큰만 있으면 되므로 org 권한이 필요 없다
  //
  // 파일명이 wrangler.jsonc 가 아닌 이유:
  //   루트에 wrangler.jsonc 를 두면 기존 ondal-fe Workers Builds 가 그걸 주워 읽어 동작이 바뀔 수 있다.
  //   Ondal 은 대시보드 설정으로 돌고 있으므로 건드리지 않는다 - 이 파일은 --config 로 명시할 때만 쓰인다
  "name": "ondal-hoj",
  "compatibility_date": "2026-09-01",

  // 스크립트 없이 정적 자산만 올리는 Worker - HOJ 는 SPA 라 서버 로직이 없다
  "assets": {
    "directory": "./dist-hoj",
    // 자산에 없는 경로(/problems/12 같은 것)는 index.html 을 200 으로 준다.
    // 없으면 주소창 직접 입력·새로고침이 전부 404 - 라우팅이 브라우저에서 일어나기 때문
    "not_found_handling": "single-page-application"
  }

  // 커스텀 도메인(hoj.haedal-sos-man-in-the-mirror.com)은 대시보드에서 1회 연결한다.
  // 여기 routes 로 선언하려면 토큰에 Zone 권한이 더 필요해서, 배포 실패 원인이 섞이지 않게 분리해 둔다
}
