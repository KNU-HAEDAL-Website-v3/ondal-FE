# 복사해서 .env.local 로 쓰세요 (.env.local 은 git 에 올라가지 않음)

# API 서버 주소. 비우면 같은 origin - 개발 서버는 /api 를 vite 프록시로 localhost:8080 에 넘긴다.
# VITE_AUTH_MODE=oidc 면 절대 주소(https://...) 필수 - 로그인이 fetch 가 아니라 브라우저 이동이라 프록시(상대 경로)로는 동작하지 않음 (빌드가 검사)
VITE_API_BASE_URL=

# 'true' 면 백엔드 대신 MSW mock 서버 사용 (npm run dev:mock 이 이 값을 켠다)
VITE_API_MOCK=false

# 로그인 방식 - BE ondal.auth.mode 와 짝. stub(기본): 아이디 폼(local BE·mock) / oidc: "홈페이지 계정으로 로그인" 버튼(운영 BE, Keycloak)
# mock 모드에서는 값과 무관하게 stub 폼. 운영 빌드(`vite build`) 값은 .env.production 에 커밋되어 있음
VITE_AUTH_MODE=stub

# 어느 앱으로 빌드할지 - 비우면 ondal(과제 플랫폼), 'hoj' 면 문제 은행 (src/lib/apps.ts). HOJ 운영 빌드 값은 .env.hoj 에 있음
VITE_APP=

# HOJ 가 따로 떠 있는 주소. **이 값이 HOJ 분리의 스위치다**
#   - 비어 있으면(기본): 문제·태그 화면이 Ondal 안에 그대로 있고, 사이드바 "HOJ로 이동하기" 는 같은 앱의 /problems 로 간다
#   - 값이 있으면: Ondal 의 /problems·/admin/tags 는 HOJ 로 넘기고(components/HojRedirect.tsx), 사이드바에서 태그 관리 메뉴가 빠지며 HOJ 링크는 새 탭으로 열린다
# 운영에서 켜는 순서: ① Pages 프로젝트 `haedal-hoj-fe`(deploy.yml 의 deploy-hoj 잡이 배포) 에 커스텀 도메인 oj.… 연결 → ② .env.production 에 아래 한 줄 추가
#   VITE_HOJ_URL=https://oj.haedal-sos-man-in-the-mirror.com
# 순서를 뒤집으면(도메인 없이 값부터 넣으면) /problems 가 없는 주소로 넘어가니 반드시 ① 먼저
VITE_HOJ_URL=

# Ondal 주소 - HOJ 앱에서 "Ondal(과제)로" 링크에 쓴다. HOJ 빌드에서만 의미 있음(.env.hoj 에 값 있음)
VITE_ONDAL_URL=
