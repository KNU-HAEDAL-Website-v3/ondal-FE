# 복사해서 .env.local 로 쓰세요 (.env.local 은 git 에 올라가지 않음)

# API 서버 주소. 비우면 같은 origin - 개발 서버는 /api 를 vite 프록시로 localhost:8080 에 넘긴다.
# VITE_AUTH_MODE=oidc 면 절대 주소(https://...) 필수 - 로그인이 fetch 가 아니라 브라우저 이동이라 프록시(상대 경로)로는 동작하지 않음 (빌드가 검사)
VITE_API_BASE_URL=

# 'true' 면 백엔드 대신 MSW mock 서버 사용 (npm run dev:mock 이 이 값을 켠다)
VITE_API_MOCK=false

# 로그인 방식 - BE ondal.auth.mode 와 짝. stub(기본): 아이디 폼(local BE·mock) / oidc: "홈페이지 계정으로 로그인" 버튼(운영 BE, Keycloak)
# mock 모드에서는 값과 무관하게 stub 폼. 운영 값은 .github/workflows/deploy.yml 의 main 빌드에서 지정
VITE_AUTH_MODE=stub
